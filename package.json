{
  "name": "sykasif-ozeluclu",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "start:proxy": "npm run start:api",
    "dev": "vite --host --port 5173",
    "dev:all": "concurrently -k -s first \"node local-api.js\" \"vite --host 0.0.0.0 --port 5173\"",
    "build": "vite build",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.api.json",
    "preview": "vite preview",
    "start:api": "node local-api.js",
    "test": "node --test",
    "twin:up": "docker compose -f infrastructure/local-twin/docker-compose.yml up -d",
    "twin:down": "docker compose -f infrastructure/local-twin/docker-compose.yml down",
    "twin:logs": "docker compose -f infrastructure/local-twin/docker-compose.yml logs -f nodeodm"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "microsoft-cognitiveservices-speech-sdk": "^1.51.0",
    "multer": "^2.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.2.4",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "oxlint": "^1.75.0",
    "typescript": "^5.7.3",
    "vite": "^8.2.0"
  }
}
