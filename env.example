# Bu dosyayı .env.local olarak kopyalayın. VITE_ öneki kullanmayın;
# VITE_ değişkenleri tarayıcı paketine gömülür.

# --- Metin/Görsel AI (öncelik sırası: Cloudflare > Gemini > Ollama > offline) ---
CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_AI_TOKEN ve CLOUDFLARE_API_TOKEN eş anlamlıdır — ikisinden biri yeterli.
CLOUDFLARE_AI_TOKEN=
CLOUDFLARE_API_TOKEN=

# İsteğe bağlı model geçersiz kılmaları:
CLOUDFLARE_TEXT_MODEL=@cf/zai-org/glm-4.7-flash
CLOUDFLARE_VISION_MODEL=@cf/llava-hf/llava-1.5-7b-hf

# Cloudflare tanımlı değilse otomatik yedek sağlayıcı:
GEMINI_API_KEY=

# --- Ses (Kâşif Asistanı) — tanımlı değilse tarayıcı ses motoruna düşer ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_ENDPOINT=

# --- Harita ve şu an hiçbir bileşenin kullanmadığı, hazırda bekleyen anahtarlar ---
AZURE_MAPS_KEY=
AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
ABACUS_API_KEY=

# --- Uydu Ajanı: SkyFi açık veri arşivi (SAR/optik) ---
# Tanımlı değilse Uydu Ajanı yalnızca Esri katman kaynağını raporlar (hata değil).
# NOT: api/skyfi.js iskelet halindedir; gerçek uç nokta/şema kendi SkyFi
# hesabınla (app.skyfi.com/platform-api/redoc) doğrulanmalıdır.
SKYFI_API_KEY=
# SKYFI_API_URL=https://app.skyfi.com/platform-api

# --- Vercel dağıtım otomasyonu (bir AI özelliği değildir) ---
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Virgülle ayrılmış izinli ek origin'ler (üretimde özel alan adı kullanıyorsanız):
APP_ORIGIN=
