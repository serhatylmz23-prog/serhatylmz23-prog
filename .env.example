# Bu dosyayı .env.local olarak kopyalayın. VITE_ öneki kullanmayın;
# VITE_ değişkenleri tarayıcı paketine gömülür.

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=

# İsteğe bağlı model geçersiz kılmaları:
CLOUDFLARE_TEXT_MODEL=@cf/zai-org/glm-4.7-flash
CLOUDFLARE_VISION_MODEL=@cf/llava-hf/llava-1.5-7b-hf

# Virgülle ayrılmış izinli ek origin'ler (üretimde özel alan adı kullanıyorsanız):
APP_ORIGIN=

# Azure Speech — Türkçe kadın sesi (tr-TR-EmelNeural) ve STT
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Yerel NodeODM dijital ikiz motoru
NODEODM_URL=http://127.0.0.1:3001

# Boş bırakılırsa yerel /api/runtime kullanılır. Cloudflare Worker dağıtımından
# sonra örn. https://sykasif-runtime.<hesap>.workers.dev yazılabilir.
VITE_SYKASIF_RUNTIME_URL=
